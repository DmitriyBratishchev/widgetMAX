{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run test:run)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsc -p tsconfig.app.json --noEmit)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git stash clear:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/block-no-verify.js" },
          { "type": "command", "command": "node .claude/hooks/block-destructive.js" },
          { "type": "command", "command": "node .claude/hooks/block-coauthored-by.js" },
          { "type": "command", "command": "node .claude/hooks/check-console-log.js" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/check-secrets.js" },
          { "type": "command", "command": "node .claude/hooks/check-hardcoded-colors.js" }
        ]
      }
    ]
  }
}
