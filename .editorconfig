# Для редакторов без Prettier. Согласовано с .prettierrc.json (он главнее) и .gitattributes (LF).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Два пробела в конце строки Markdown — перенос строки.
[*.md]
trim_trailing_whitespace = false
